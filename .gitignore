# Nothing that comes from a game disc or an arcade ROM belongs in this repo.
# Disc images, built images, work directories and arcade-derived data stay local.
*.bin
!tools/**/*.bin
# our own card artwork layer (MSHvSF), and its copy in the builder's frozen tool tree
!games/mshvsf/tools/logo/mshcard2.bin
!builder/data/mshvsf/tools/games/mshvsf/tools/logo/mshcard2.bin
*.cue
*.chd
*.iso
*.zip
/work/
/build/
/out/
/games/*/disc/
/games/*/build/
/games/*/work/
*.npy
*.npz

# build products of the MIPS sources (the builder uses builder/data/blobs, where words of the
# game are references filled in from your disc; the linked outputs below would hold them verbatim)
*.o
*.elf
tools/tagload/**/tagload.*.bin
tools/tagload/**/tagload.sym
tools/nspdec/nspdec.bin
tools/nspdec/nspdec.sym
# the speed modules' assembled code (python tools/speed/<module>.py build; the builder uses builder/data/blobs)
tools/speed/**/*.bin
tools/speed/frame/bin/
tools/speed/*/obj/
# MSHvSF module build products (the builder uses builder/data/mshvsf/blobs)
games/**/obj/
games/**/bin/
games/mshvsf/tools/tagload/tagload.*.bin

__pycache__/
*.pyc

# machine-specific tool paths (see local_paths.example.json)
/local_paths.json

# generated by patcher/make.py --bundle-only (test harness input)
/patcher/xvsf_bundle.zip
